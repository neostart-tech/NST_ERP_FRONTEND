<script>
export default {
    data() {
        return {
            activeDoc: 'invoice', // 'invoice', 'proforma', 'delivery'
            preview: false,
            cabinetInfo: {
                name: "TECHNO SERVICE SARL",
                address: "123 Rue des Réparations, 75000 Paris",
                city: "Paris",
                phone: "+33 1 23 45 67 89",
                email: "contact@technoservice.fr",
                siret: "123 456 789 00010",
                vatNumber: "FR00123456789"
            },
            client: {
                type: "company",
                name: "",
                address: "",
                phone: "",
                email: ""
            },
            document: {
                number: "",
                date: new Date().toISOString().split('T')[0],
                dueDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
                maintenanceContract: "false"
            },
            items: [
                { description: "Maintenance équipement", quantity: 1, unitPrice: 120 },
                { description: "Pièce de rechange", quantity: 1, unitPrice: 45 }
            ]
        }
    },
    computed: {
        documentTitle() {
            return {
                'invoice': 'FACTURE',
                'proforma': 'DEVIS PROFORMA',
                'delivery': 'BORDEREAU DE LIVRAISON'
            }[this.activeDoc]
        },
        total() {
            return this.items.reduce((sum, item) => sum + (item.quantity * item.unitPrice), 0)
        }
    },
    methods: {
        formatDate(dateString) {
            if (!dateString) return ''
            const date = new Date(dateString)
            return date.toLocaleDateString('fr-FR')
        },
        addItem() {
            this.items.push({ description: "", quantity: 1, unitPrice: 0 })
        },
        removeItem(index) {
            this.items.splice(index, 1)
            this.updateTotal()
        },
        updateTotal() {
            // Force Vue to update computed total
            this.$forceUpdate()
        },
        resetForm() {
            this.client = {
                type: "company",
                name: "",
                address: "",
                phone: "",
                email: ""
            }
            this.document = {
                number: "",
                date: new Date().toISOString().split('T')[0],
                dueDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
                maintenanceContract: "false"
            }
            this.items = [
                { description: "Maintenance équipement", quantity: 1, unitPrice: 120 },
                { description: "Pièce de rechange", quantity: 1, unitPrice: 45 }
            ]
            this.preview = false
        },
        generateDocument() {
            // Générer un numéro de document si vide
            if (!this.document.number) {
                const prefix = {
                    'invoice': 'FAC',
                    'proforma': 'PRO',
                    'delivery': 'BL'
                }[this.activeDoc]
                this.document.number = `${prefix}-${new Date().getFullYear()}-${Math.floor(Math.random() * 1000).toString().padStart(3, '0')}`
            }
            this.preview = true
        },
        printDocument() {
            window.print()
        },
        downloadPDF() {
            // Ici vous pourriez intégrer une librairie comme html2pdf.js pour générer un PDF
            alert("Fonctionnalité PDF à implémenter")
        }
    }
}
</script>

